{
  "name": "@gsong/ccmcp",
  "version": "1.4.0",
  "description": "Claude Code MCP Selector - Intelligently discover, validate, and select MCP server configurations for Claude Code",
  "keywords": [
    "claude",
    "mcp",
    "cli",
    "selector",
    "configuration"
  ],
  "license": "MIT",
  "author": "George Song",
  "homepage": "https://github.com/gsong/ccmcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsong/ccmcp.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.13.1",
  "bin": {
    "ccmcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "build": "run-s lint type-check _build:compile",
    "fix": "run-s lint:fix _fix:prettier type-check",
    "lint": "biome check src scripts",
    "lint:actions": "mise exec -- actionlint",
    "lint:fix": "biome check --write src scripts",
    "type-check": "tsc --noEmit",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "_build:compile": "tsdown",
    "_build:clean": "rm -rf dist",
    "_fix:prettier": "prettier --write '**/*.{md,json,yaml,yml}'",
    "_release:generate-notes": "node scripts/generate-release-notes.js",
    "_release:clean-files": "rm -f .tmp-tag-notes.txt .tmp-release-prompt.txt"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.7",
    "shell-quote": "^1.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^22",
    "@types/react": "^19.2.17",
    "@types/shell-quote": "^1.7.5",
    "actions-up": "^1.16.0",
    "ink-testing-library": "^4.0.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.5",
    "tsdown": "^0.22.9",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
